{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonder durable event envelope v1",
  "type": "object",
  "required": [
    "id",
    "botId",
    "type",
    "schemaVersion",
    "correlationId",
    "createdAt",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "botId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "chat",
        "outgoing",
        "reflection",
        "emotion",
        "relationship",
        "memory",
        "memory-maintenance",
        "embedding",
        "maintenance",
        "narrative",
        "summary",
        "deletion-ledger"
      ]
    },
    "payload": {
      "type": "string",
      "description": "Serialized JSON. Chat/outgoing/consumers use {id}; reflection uses sessionId, subjectId, boundary, epoch, kind; summary uses sessionId, throughSequence."
    }
  },
  "additionalProperties": true
}
