<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
        <PackageReference Include="Quartz" Version="4.6.2"/>
        <PackageReference Include="Milky.Net.Client" Version="1.3.0"/>
        <ProjectReference Include="../Wonder.Core/Wonder.Core.csproj"/>
        <ProjectReference Include="../Wonder.Infrastructure/Wonder.Infrastructure.csproj"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <Content Remove="Tokenizer/**/*"/>
        <None Remove="Tokenizer/**/*"/>
        <Content Include="Tokenizer/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never"/>
        <Content Remove="data/**"/>
        <None Remove="data/**"/>
    </ItemGroup>
    <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish">
        <Exec WorkingDirectory="../Wonder.Web" Command="npm ci --no-fund --no-audit" Condition="'$(SkipFrontendBuild)' != 'true'"/>
        <Exec WorkingDirectory="../Wonder.Web" Command="npm run build" Condition="'$(SkipFrontendBuild)' != 'true'"/>
        <Error Condition="!Exists('../Wonder.Web/dist/index.html')" Text="Build Wonder.Web before publishing with SkipFrontendBuild=true."/>
        <ItemGroup>
            <FrontendFiles Include="../Wonder.Web/dist/**/*"/>
            <ResolvedFileToPublish Include="@(FrontendFiles)">
                <RelativePath>wwwroot/%(FrontendFiles.RecursiveDir)%(FrontendFiles.Filename)%(FrontendFiles.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
