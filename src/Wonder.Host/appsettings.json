{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Authentication": {
    "AllowRegistration": true,
    "RequireHttps": false
  },
  "Workers": {
    "Enabled": true
  },
  "MemoryLifecycle": {
    "Enabled": true
  },
  "Chat": {
    "TimeZone": "Asia/Shanghai",
    "InteractionToolsEnabled": false,
    "ReflectionToolsEnabled": false,
    "NotesToolsEnabled": false
  },
  "Storage": {
    "MediaPath": "data/media",
    "KeysPath": "data/keys"
  },
  "Backups": {
    "Path": "data/backups",
    "DeletionLedgerPath": "data/deletion-ledger",
    "RetiredContextPath": "data/retired-context",
    "AgeRecipient": ""
  },
  "SystemAdminIds": [],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
