{
  "name": "wonder-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix tools ci --no-fund --no-audit",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/extract-styles.cjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm --prefix tools run typecheck",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "generate:api": "npm --prefix tools run generate:api"
  },
  "dependencies": {
    "ant-design-vue": "4.2.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
