# These are Podman env files: values are literal, without shell/Compose interpolation.
# Use the same database password as postgres.env.
ConnectionStrings__Postgres=Host=postgres;Database=wonder;Username=wonder;Password=replace-with-a-long-random-password;Maximum Pool Size=20
ConnectionStrings__Redis=redis:6379
# Local HTTP testing. Set Production when accessing through an HTTPS reverse proxy.
ASPNETCORE_ENVIRONMENT=Development
Authentication__AllowRegistration=true
Backups__AgeRecipient=
SystemAdminIds__0=
