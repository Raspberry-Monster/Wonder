[Unit]
Description=Wonder SnowLuma Podman Container

[Container]
ContainerName=wonder-snowluma
Image=docker.io/motricseven7/snowluma:v2.0.3
Network=wonder
NetworkAlias=snowluma
Environment=TZ=Asia/Shanghai
Environment=SNOWLUMA_ONEBOT_HOST=0.0.0.0
Environment=SNOWLUMA_WEBUI_HOST=0.0.0.0
Volume=%h/quadlet.config.d/Wonder/SnowLuma/Data:/app/data:Z
Volume=%h/quadlet.config.d/Wonder/SnowLuma/Config:/app/.config:Z
Volume=%h/quadlet.config.d/Wonder/SnowLuma/Share:/app/.local/share:Z
PublishPort=192.168.1.102:6081:6081
PublishPort=192.168.1.102:5099:5099
PublishPort=127.0.0.1:3001:3001
ShmSize=1g
Ulimit=nofile=65536:1048576
AddCapability=SYS_PTRACE
SeccompProfile=unconfined
StopTimeout=60

[Service]
Restart=always

[Install]
WantedBy=default.target
