[Unit]
Description=Wonder PostgreSQL Podman Container

[Container]
ContainerName=wonder-postgres
Image=docker.io/pgvector/pgvector:pg18
Network=wonder
NetworkAlias=postgres
Environment=TZ=Asia/Shanghai
Environment=POSTGRES_DB=wonder
Environment=POSTGRES_USER=wonder
Environment=POSTGRES_PASSWORD=replace-with-a-long-random-password
Volume=%h/quadlet.config.d/Wonder/PostgreSQL:/var/lib/postgresql:Z
PublishPort=127.0.0.1:5432:5432
StopTimeout=60

[Service]
Restart=always

[Install]
WantedBy=default.target
