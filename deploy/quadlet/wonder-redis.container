[Unit]
Description=Wonder Redis Podman Container

[Container]
ContainerName=wonder-redis
Image=docker.io/library/redis:8-alpine
Network=wonder
NetworkAlias=redis
Environment=TZ=Asia/Shanghai
Volume=%h/quadlet.config.d/Wonder/Redis:/data:Z
Exec=redis-server --appendonly yes
StopTimeout=60

[Service]
Restart=always

[Install]
WantedBy=default.target
