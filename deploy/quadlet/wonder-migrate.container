[Unit]
Description=Wonder database migration (run manually with the application stopped)
Requires=wonder-postgres.service
After=wonder-postgres.service

[Container]
ContainerName=wonder-migrate
Image=localhost/wonder:0.1
Network=wonder
Environment=TZ=Asia/Shanghai
# Keep this password identical to wonder-postgres.container and wonder-app.container.
Environment="ConnectionStrings__Postgres=Host=postgres;Database=wonder;Username=wonder;Password=replace-with-a-long-random-password"
Volume=%h/quadlet.config.d/Wonder/Host:/app/data:U,z
Exec=--migrate
StopTimeout=60

[Service]
Type=oneshot
RemainAfterExit=yes
